{
  "name": "le-loyon",
  "productName": "Le Loyon",
  "private": true,
  "version": "0.1.0",
  "description": "Le Loyon, a PS1-style psychological horror game",
  "author": "Le Loyon",
  "desktopName": "le-loyon.desktop",
  "type": "module",
  "main": "dist-electron/main.js",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "electron": "^45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "shot": "node tools/shot.mjs",
    "electron:dev": "tsc -p tsconfig.node.json && node tools/electron.mjs --dev",
    "electron": "npm run build && node tools/electron.mjs",
    "smoke": "node tools/smoke.mjs",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --linux --win",
    "icon": "node tools/package/icon.mjs",
    "dist:check": "node tools/package/launch-check.mjs"
  }
}
